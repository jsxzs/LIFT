Bootstrap: docker
From: python:3.12

# LIFT training/inference image for aarch64 hosts (e.g. NVIDIA GH200), CUDA 12.6.
#
# Everything is baked in, so the resulting SIF is read-only and self-contained: any number of
# concurrent jobs can mount the same image.
#
# Build (needs network, ~15 min):
#   apptainer build --fakeroot LIFT.sif env.def
# Run:
#   apptainer exec --nv --cleanenv --env PYTHONPATH=<repo> LIFT.sif python3 ...

%files
    requirements.txt /opt/requirements.txt

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    # ffmpeg for imageio/moviepy/av encoding; libgl+libglib for opencv (headless still links them)
    apt-get update
    apt-get install -y --no-install-recommends ffmpeg libgl1 libglib2.0-0 git
    rm -rf /var/lib/apt/lists/*

    python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

    # aarch64 CUDA 12.6 wheels are only on the pytorch index; --extra-index-url so the rest of the
    # requirements still resolve from PyPI.
    python3 -m pip install --no-cache-dir -r /opt/requirements.txt \
        --extra-index-url https://download.pytorch.org/whl/cu126

    # flash-attn has no aarch64 wheel upstream; mjun0812 publishes prebuilt ones. Pinned by URL to
    # the exact python/torch/cuda triple -- building from source here would take hours.
    python3 -m pip install --no-cache-dir \
        https://github.com/mjun0812/flash-attention-prebuild-wheels/releases/download/v0.9.48/flash_attn-2.8.3+cu126torch2.13-cp312-cp312-manylinux_2_34_aarch64.whl

    python3 -m pip check || true
    rm -f /opt/requirements.txt

%environment
    export PYTHONUNBUFFERED=1
    export TOKENIZERS_PARALLELISM=false

%labels
    Project LIFT
    Arch aarch64
    CUDA 12.6
    Torch 2.13.0
